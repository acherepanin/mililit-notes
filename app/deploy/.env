# Образ в GHCR (push/pull и образ в docker-compose.yml)
IMAGE=ghcr.io/owner/notes-app:latest
# Хост удалённого сервера
REMOTE_HOST=example.com
# SSH-порт
REMOTE_PORT=22
# SSH-пользователь
REMOTE_USER=deploy
# Каталог на сервере для docker-compose.yml
REMOTE_DIR=/home/deploy/notes
# Путь к SSH-ключу (опционально)
REMOTE_SSH_KEY=
