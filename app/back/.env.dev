# =============================================================================
# Слой окружения DEVELOPMENT (.env.dev).
# Переопределяет значения базового .env. Активируется через APP_ENV=dev
# (npm run start:dev / docker-compose.dev.yml).
# =============================================================================

NODE_ENV=development

# В Docker Compose backend ходит к Postgres по имени сервиса.
# Compose переопределяет DB_HOST=postgres; при локальном запуске на хосте
# используется DB_HOST=localhost из базового .env.
DB_SYNCHRONIZE=true
DB_LOGGING=false
