# =============================================================================
# Сервер приложения
# =============================================================================

# Режим работы: development | production
NODE_ENV=development
# HTTP-порт backend (SPA и API на одном порту)
PORT=3000

# =============================================================================
# База данных
# =============================================================================

# Путь к файлу SQLite (относительный — от каталога app/back при локальном запуске)
DB_PATH=notes.sqlite

# =============================================================================
# Первый администратор (создаётся при пустой БД; в development пароль обновляется при старте)
# =============================================================================

# Логин seed-admin
ADMIN_USERNAME=admin
# Пароль seed-admin
ADMIN_PASSWORD=adm136479

# =============================================================================
# Аутентификация (токены сессии)
# =============================================================================

# Секрет HMAC для подписи токенов (в production обязателен уникальный, не dev-значение)
AUTH_SECRET=S1tcUJei6WWX1D8WYaq9
# Время жизни токена в секундах (1209600 = 14 дней)
AUTH_TOKEN_TTL_SECONDS=1209600

# =============================================================================
# Шифрование секретных полей в заметках (AES-256-GCM)
# =============================================================================

# Ключ шифрования password/token/secret полей данных
SECRET_ENCRYPTION_KEY=dev-notes-secret-key-change-in-prod

# =============================================================================
# Шифрование API-ключей AI-провайдеров (AES-256-GCM)
# =============================================================================

# Ключ шифрования сохранённых ключей OpenAI и других провайдеров
AI_CREDENTIALS_ENCRYPTION_KEY=dev-ai-credentials-key-change-in-prod

# =============================================================================
# Notes AI
# =============================================================================

# Модель распознавания голоса (Telegram/VK → OpenAI-compatible /audio/transcriptions)
AI_TRANSCRIPTION_MODEL=whisper-1

# URL удалённого JSON-каталога моделей (необязательно; пусто = только встроенный seed)
# AI_MODEL_CATALOG_URL=

# =============================================================================
# Файловые вложения
# =============================================================================

# Каталог хранения загруженных файлов
UPLOAD_DIR=uploads
# Максимальный размер одного файла, МБ
MAX_UPLOAD_SIZE_MB=25
# Разрешённые расширения через запятую (с точкой)
ALLOWED_UPLOAD_EXTENSIONS=.txt,.md,.json,.yaml,.yml,.env,.png,.jpg,.jpeg,.webp,.pdf,.zip

# =============================================================================
# Подписки и оплата
# =============================================================================

# Mock-оплата в production: true | false (в development mock доступен без этой переменной)
# ALLOW_MOCK_CHECKOUT=false

# =============================================================================
# Публичный URL приложения
# =============================================================================

# Базовый URL SPA для ссылок подтверждения email при регистрации
APP_PUBLIC_URL=http://localhost:3000

# =============================================================================
# Почта (SMTP)
# =============================================================================
# Без SMTP_HOST ссылка подтверждения регистрации пишется в лог сервера, письмо не отправляется.
# Хост SMTP-сервера
# SMTP_HOST=
# Порт SMTP (587 — STARTTLS, 465 — SMTPS)
# SMTP_PORT=587
# true — SMTPS (обычно порт 465); false — STARTTLS
# SMTP_SECURE=false
# Логин SMTP
# SMTP_USER=
# Пароль SMTP
# SMTP_PASS=
# Адрес отправителя писем
# SMTP_FROM=notes@localhost
