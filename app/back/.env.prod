# =============================================================================
# Слой окружения PRODUCTION (.env.prod).
# Переопределяет значения базового .env. Активируется через APP_ENV=prod
# (npm run start / docker-compose.yml).
# Файл запекается в Docker-образ, поэтому продовый compose ничего не передаёт.
# =============================================================================

NODE_ENV=production

# Подключение к Postgres внутри прод-сети Docker Compose (имя сервиса `postgres`).
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=adm136479
DB_NAME=notes
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Безопасность: замените на уникальные значения перед реальным деплоем.
AUTH_SECRET=S1tcUJei6WWX1D8WYaq9
SECRET_ENCRYPTION_KEY=dev-notes-secret-key-change-in-prod
AI_CREDENTIALS_ENCRYPTION_KEY=dev-ai-credentials-key-change-in-prod

APP_PUBLIC_URL=http://localhost:3000
