{
  "name": "@notes/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:import:legacy": "pnpm build && node dist/import-legacy.js",
    "db:migrate": "pnpm build && node dist/migrate.js",
    "db:verify-backup-restore": "pnpm build && node dist/verify-backup-restore.js",
    "db:verify": "pnpm build && node dist/verify.js",
    "files:verify-backup-restore": "pnpm build && node dist/verify-object-backup-restore.js",
    "files:migrate:legacy": "pnpm build && node dist/migrate-files.js",
    "files:verify": "pnpm build && node dist/migrate-files.js --verify-only",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src drizzle.config.ts --max-warnings=0",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/lib-storage": "^3.1102.0",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.1",
    "pg": "^8.22.0",
    "pg-cursor": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.3",
    "@types/pg-cursor": "^2.7.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
