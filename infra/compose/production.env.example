# Compose automatically enables the optional monitoring services listed here.
COMPOSE_PROFILES=observability

APP_DOMAIN=notes.example.com
OBJECT_STORAGE_DOMAIN=files.notes.example.com
ACME_EMAIL=ops@example.com

# Use GHCR references pinned by digest, never latest or a mutable branch tag.
NOTES_API_IMAGE=ghcr.io/owner/repository-api@sha256:replace_me
NOTES_WEB_IMAGE=ghcr.io/owner/repository-web@sha256:replace_me
NOTES_WORKER_IMAGE=ghcr.io/owner/repository-worker@sha256:replace_me
NOTES_DB_IMAGE=ghcr.io/owner/repository-db@sha256:replace_me

POSTGRES_DB=notes_ai
POSTGRES_USER=notes_ai
POSTGRES_PASSWORD=replace_with_url_safe_random_value
DATABASE_URL=postgresql://notes_ai:replace_with_url_safe_random_value@postgres:5432/notes_ai

REDIS_PASSWORD=replace_with_url_safe_random_value
REDIS_URL=redis://:replace_with_url_safe_random_value@redis:6379

MINIO_ROOT_USER=notes_ai_root
MINIO_ROOT_PASSWORD=replace_with_random_root_value
MINIO_APP_USER=notes_ai_app
MINIO_APP_PASSWORD=replace_with_random_application_value
OBJECT_STORAGE_BUCKET=notes-ai

# Generate independent values with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_64_hex_characters
INTERNAL_INTEGRATION_SECRET=replace_with_64_hex_characters
AI_PROVIDER_ENCRYPTION_KEY=replace_with_64_hex_characters
INTEGRATION_ENCRYPTION_KEY=replace_with_64_hex_characters
INTEGRATION_LINK_HASH_KEY=replace_with_64_hex_characters
NOTE_FIELD_ENCRYPTION_KEY=replace_with_64_hex_characters

# Preserve legacy keys only when existing encrypted rows still need them. Keep
# previous current-format keys only during an intentional rotation read window.
AI_CREDENTIALS_ENCRYPTION_KEY=
LEGACY_SECRET_ENCRYPTION_KEY=
AI_PROVIDER_ENCRYPTION_KEY_PREVIOUS=
INTEGRATION_ENCRYPTION_KEY_PREVIOUS=
AI_PROVIDER_ENDPOINT_ALLOWLIST=

SMTP_FROM="Notes AI <no-reply@notes.example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace_me
SMTP_PASS=replace_me

# Copy alertmanager.production.example.yml outside the repository, fill it in,
# set mode 600, and point this absolute host path at the resulting file.
ALERTMANAGER_CONFIG_PATH=/opt/notes-ai/config/alertmanager.yml
PROMETHEUS_RETENTION=30d
