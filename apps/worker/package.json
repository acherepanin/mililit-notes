{
  "name": "@notes/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src scripts --max-warnings=0",
    "start": "node dist/main.js",
    "test": "vitest run src",
    "verify:correlation": "tsx scripts/verify-correlation.ts",
    "verify:retention": "tsx scripts/verify-retention.ts",
    "verify:upload-cleanup": "tsx scripts/verify-upload-cleanup.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@fastify/otel": "0.20.1",
    "@notes/config": "workspace:*",
    "@notes/db": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/instrumentation-undici": "0.31.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "bullmq": "^6.0.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "ioredis": "^5.11.1",
    "nodemailer": "9.0.4",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
