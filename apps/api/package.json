{
  "name": "@notes/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src scripts --max-warnings=0",
    "start": "node dist/main.js",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:files-http": "tsx scripts/verify-files-http.ts",
    "verify:ai-http": "tsx scripts/verify-ai-http.ts",
    "verify:alerting": "tsx scripts/verify-alerting.ts",
    "verify:billing": "tsx scripts/verify-admin-billing.ts",
    "verify:integrations": "tsx scripts/verify-integrations.ts",
    "verify:load": "tsx scripts/verify-load.ts",
    "verify:metrics": "tsx scripts/verify-metrics.ts",
    "verify:openapi": "pnpm build && tsx scripts/verify-openapi.ts",
    "verify:observation": "tsx scripts/verify-observation.ts",
    "verify:traces": "tsx scripts/verify-traces.ts",
    "verify:http": "tsx scripts/verify-notes-http.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@better-auth/passkey": "1.6.25",
    "@better-auth/redis-storage": "1.6.25",
    "@fastify/otel": "0.20.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@notes/config": "workspace:*",
    "@notes/db": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.67.0",
    "@opentelemetry/instrumentation-undici": "0.31.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "archiver": "^7.0.1",
    "argon2": "0.45.1",
    "better-auth": "1.6.25",
    "bullmq": "6.0.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.11.2",
    "file-type": "^22.0.1",
    "grammy": "1.45.1",
    "ioredis": "5.8.2",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "vk-io": "4.10.1"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "catalog:",
    "fflate": "^0.8.3",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
